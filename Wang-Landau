def E_exp(T,L,log_gE):
    energies = np.array(list(log_gE.keys()))
    counts = np.array(list(log_gE.values()))
    log_weight = counts - energies/T
    weight = log_weight - max(log_weight)
    exponent = np.exp(weight)
    S1 = energies*exponent
    S2 = exponent
    S = sum(S1)/sum(S2)
    return S/(L*L)


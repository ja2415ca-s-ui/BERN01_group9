import numpy as np
from matplotlib import pyplot as plt

rng = np.random.default_rng(12345)
def delta(s_i: float, s_j: float):
    return int(bool(s_i == s_j))

def delta_arr(s: np.ndarray, t: np.ndarray):
    i, j = np.meshgrid(np.arange(len(s)), np.arange(len(s)), indexing='ij')
    return np.astype(s[i,j] == t[i,j], int)

def nearest_neighbor(x: int, y: int, Lx: int, Ly: int): #only vertical/horizontal counted as nearest-neighbor
    return [[(x-1)%Lx, y%Ly], [(x+1)%Lx, y%Ly], [x%Lx, (y-1)%Ly], [x%Lx, (y+1)%Ly]]

def Energy(s: np.ndarray, J=1):
    S = []
    Lx = len(s[:,0])
    Ly = len(s[0])
    i,j = np.meshgrid(np.arange(Lx), np.arange(Ly), indexing='ij')
    nn = nearest_neighbor(np.arange(Lx)[i], np.arange(Ly)[j], Lx, Ly)
    for l in range(4):
        S.append(delta_arr(s[nn[l][0][:], nn[l][1][:]], s))
    S_final = np.sum(S, axis=1)
    return -J/2 * np.sum(S_final) #multiply by 1/2 to take into account that each nearest-neighbor pair is counted twice

def exp_val(x):
    return 1/len(x) * sum(x)

def Tc(q):
    return 1/np.log(1+np.sqrt(q))

def lattice(q: int, Lx: int, Ly: int):
    q_list = np.arange(1,q+1)
    return rng.choice(q_list,(Lx,Ly))

def probability_log(g1_log, g2_log):
    return min(g1_log - g2_log, 0)

def Wang_Landau(s, f, gE_log, h_E, n, q, Lx, Ly):
    s0 = s
    E0 = Energy(s0)
    for _ in range(n):
        i, j = [rng.choice(Lx),rng.choice(Ly)]
        old_value = int(s0[i,j])
        s_new = s0.copy()
        s_new[i,j] = rng.choice(list(set(np.arange(1,q+1)) - {old_value}))

        E_new = Energy(s_new)
        if E_new not in gE_log:
            gE_log[E_new] = 0
        if E_new not in h_E:
            h_E[E_new] = 0
        if E0 not in gE_log:
            gE_log[E0] = 0
        if E0 not in h_E:
            h_E[E0] = 0

        R = rng.random()
        if np.log(R) < probability_log(gE_log[E0], gE_log[E_new]):
            E0 = E_new
            s0 = s_new

        gE_log[E0] = gE_log[E0] + np.log(f)
        h_E[E0] = h_E[E0] + 1
  return gE_log, h_E, s0

def flatness_condition(h_E, tol=0.8):
    h_mean = np.mean(list(h_E.values()))
    E_list = []
    for E in h_E.keys():
        if h_E[E] > tol*h_mean:
            E_list.append(E)
    return (len(E_list)/len(h_E.keys()) == 1.0)

